PORT=3000
# Necesaria para interpretar fechas/horas en lenguaje natural del cliente
# (ver dateutils.js). Sin esta variable, el sistema sigue funcionando pero
# cae a un parser más rígido basado en reglas.
ANTHROPIC_API_KEY=sk-ant-...
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu_auth_token_aqui
NUMERO_RECEPCION=+52XXXXXXXXXX
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Solo necesario en producción con volumen persistente (ej. Railway): ruta
# absoluta al archivo SQLite dentro del volumen montado. En local se puede
# omitir (usa ./consultorio.db junto al código).
# DB_PATH=/data/consultorio.db
# Token secreto para descargar respaldos vía GET /api/backup?token=...
# Genera uno propio (ej. una cadena aleatoria larga) y no lo compartas.
# BACKUP_TOKEN=
